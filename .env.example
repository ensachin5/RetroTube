# ==============================================================================
# RetroTube Environment Configuration
# ==============================================================================

# Path or binary name for yt-dlp executable (must be reachable without shell)
YTDLP_PATH=yt-dlp

# Path or binary name for ffmpeg executable (used for stream merging and audio conversion)
FFMPEG_PATH=ffmpeg

# Directory where temporary download/merge files are staged before streaming
# Files are kept for FILE_TTL_MINUTES before cleanup or after complete stream delivery
TEMP_DIR=./tmp/retrotube

# Path to the SQLite database file (single-file persistence via better-sqlite3)
DB_PATH=./data/retrotube.db

# Maximum number of concurrent single-video download jobs (default: 2)
MAX_CONCURRENT_JOBS=2

# Maximum allowed video duration in minutes (0 = unlimited; soft guard)
MAX_VIDEO_MINUTES=0

# Maximum allowed single-file size in gigabytes (0 = unlimited; soft guard)
MAX_FILE_SIZE_GB=0

# Minimum free disk space in gigabytes required before starting any download job
# Prevents host filesystem exhaustion (statfs guard)
MIN_FREE_DISK_GB=2

# Retention time in minutes for completed files staged in TEMP_DIR (default: 120)
# Allows slow mobile/cellular connections to complete and pause/resume
FILE_TTL_MINUTES=120

# Optional: Metadata cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Optional: Per-IP in-memory rate limits per minute
RATE_LIMIT_FETCH_PER_MIN=20
RATE_LIMIT_DOWNLOAD_PER_MIN=10

# Optional: Structured JSON log level (debug | info | warn | error)
LOG_LEVEL=info

# Optional: Timeouts in milliseconds for yt-dlp metadata fetch and media downloads
YTDLP_FETCH_TIMEOUT_MS=30000
YTDLP_DOWNLOAD_TIMEOUT_MS=1800000

# ==============================================================================
# V2 Playlist & Batch Settings
# ==============================================================================

# Maximum number of items allowed to be listed or selected from a playlist (default: 200)
MAX_PLAYLIST_ITEMS=200

# Maximum number of concurrent items processed in batch queue (default: 1, max: 3)
BATCH_CONCURRENCY=1

# Randomized jitter delay in milliseconds between batch item downloads (default: 1000)
# Helps prevent IP rate-limiting from YouTube during batch operations
BATCH_ITEM_DELAY_MS=1000

# Optional: Host directory to save completed batch files directly on the server
# If set, batch items are automatically copied here in addition to browser download
SERVER_SAVE_DIR=

# ==============================================================================
# Download Acceleration & Speed Tuning
# ==============================================================================

# Number of parallel fragment downloads for DASH/HLS formats (e.g. 1080p, 4K, 8K)
# Default: 16 (drastically improves throughput over default serial fragment fetching)
YTDLP_CONCURRENT_FRAGMENTS=16

# HTTP chunk size for range requests (default: none)
# Setting to none lets yt-dlp stream at full unthrottled connection bandwidth
YTDLP_HTTP_CHUNK_SIZE=none

# Socket read buffer size (default: 1024K = 1 MB)
YTDLP_BUFFER_SIZE=1024K

# Optional: Enable external aria2c multi-connection downloader (true | false, default: false)
# Requires aria2c to be installed (built into RetroTube Docker container)
YTDLP_USE_ARIA2=false

# Optional: HTTP/HTTPS/SOCKS5 proxy URL (e.g. socks5://127.0.0.1:9050 or http://user:pass@proxy:8080)
# Useful to route downloads through clean residential or unthrottled IPs
YTDLP_PROXY=

# Optional: Absolute path to a Netscape-formatted cookies.txt file
# Enables access to YouTube Premium high-bitrate streams, age-restricted content, and prevents bot-detection throttling
YTDLP_COOKIES_FILE=

# Optional: Raw Netscape-formatted cookies.txt text content (IDEAL FOR VERCEL / SERVERLESS)
# Paste the contents of your exported cookies.txt directly into Vercel Environment Variables.
# Completely eliminates YouTube 429 rate-limiting and bot blocks on cloud datacenter IPs!
YTDLP_COOKIES_TEXT=

# Optional: Base64-encoded Netscape-formatted cookies.txt (Alternative for Vercel)
YTDLP_COOKIES_BASE64=

# Optional: Extract YouTube cookies directly from local browser (e.g. chrome, brave, safari, firefox, edge)
YTDLP_COOKIES_FROM_BROWSER=
